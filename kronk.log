// Command tictactoe plays a two player game of tic-tac-toe in the terminal.
package main

import (
	"bufio"
	"fmt"
	"os"
	"slices"
	"strings"
)

// stdin is the single reader shared by every move and replay prompt.
var stdin = bufio.NewReader(os.Stdin)

// Board holds nine cells. A zero byte is empty, otherwise it is 'X' or 'O'.
// Index 0 is displayed as position 1 through index 8, displayed as position 9.
type Board [9]byte

// wins lists the eight winning cell index triples.
var wins = [8][3]int{
	{0, 1, 2}, {3, 4, 5}, {6, 7, 8},
	{0, 3, 6}, {1, 4, 7}, {2, 5, 8},
	{0, 4, 8}, {2, 4, 6},
}

func main() {
	var xWins, oWins, draws int

	for {
		var b Board
		var player byte = 'X'

		renderBoard(&b, xWins, oWins, draws)

		for {
			var move int
			if player == 'X' {
				move = playerX(&b)
			} else {
				move = playerO(&b)
			}
			b[move] = player

			switch {
			case hasWinner(&b):
				if player == 'X' {
					xWins++
				} else {
					oWins++
				}
				renderBoard(&b, xWins, oWins, draws)
				fmt.Printf("Player %c wins!\n", player)
			case boardFull(&b):
				draws++
				renderBoard(&b, xWins, oWins, draws)
				fmt.Println("It's a draw.")
			default:
				if player == 'X' {
					player = 'O'
				} else {
					player = 'X'
				}
				renderBoard(&b, xWins, oWins, draws)
				continue
			}
			break
		}

		fmt.Print("Play again? (y/n): ")
		if answer, _ := stdin.ReadString('\n'); !strings.EqualFold(strings.TrimSpace(answer), "y") {
			return
		}
	}
}

// renderBoard clears the terminal and prints the score above the grid.
func renderBoard(b *Board, xWins, oWins, draws int) {
	fmt.Print("\033[2J\033[H")
	fmt.Println()
	fmt.Printf("Score: X: %d | O: %d | Draws: %d\n", xWins, oWins, draws)

	for row := range 3 {
		fmt.Print(" ")
		for col := range 3 {
			if col > 0 {
				fmt.Print(" \033[32m|\033[0m ")
			}
			cell := b[row*3+col]
			switch cell {
			case 'X':
				fmt.Print("\033[1;31mX\033[0m")
			case 'O':
				fmt.Print("\033[1;32mO\033[0m")
			default:
				fmt.Printf("\033[37m%d\033[0m", row*3+col+1)
			}
		}
		fmt.Println()
		if row < 2 {
			fmt.Print("\033[32m-----------\033[0m\n")
		}
	}
	fmt.Println()
}

// playerX prompts player X for a move and returns the zero based cell index.
func playerX(b *Board) int {
	return askMove(b, "Player X's turn. Enter a number (1-9): ")
}

// playerO prompts player O for a move and returns the zero based cell index.
func playerO(b *Board) int {
	return askMove(b, "Player O's turn. Enter a number (1-9): ")
}

// askMove reads lines until the player names an empty position from 1 to 9.
func askMove(b *Board, prompt string) int {
	for {
		fmt.Print(prompt)
		line, _ := stdin.ReadString('\n')
		if answer := strings.TrimSpace(line); len(answer) == 1 && answer[0] >= '1' && answer[0] <= '9' {
			if cell := int(answer[0] - '1'); b[cell] == 0 {
				return cell
			}
		}
		fmt.Println("Invalid move. Enter an empty position from 1 to 9.")
	}
}

// hasWinner reports whether any winning line is fully claimed by one player.
func hasWinner(b *Board) bool {
	for _, w := range wins {
		if b[w[0]] != 0 && b[w[0]] == b[w[1]] && b[w[1]] == b[w[2]] {
			return true
		}
	}
	return false
}

// boardFull reports whether every cell is occupied.
func boardFull(b *Board) bool {
	return !slices.Contains(b[:], byte(0))
}

