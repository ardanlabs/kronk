# Reference settings for kronk.service and kronk-user.service. This file is
# not installed by default. To use it, copy it, uncomment what you need, and
# restart.
#
# System service:
#
#   sudo install -m 0600 zarf/systemd/kronk.env /etc/kronk/kronk.env
#   sudoedit /etc/kronk/kronk.env
#   sudo systemctl restart kronk
#
# User service:
#
#   install -D -m 0600 zarf/systemd/kronk.env ~/.config/kronk/kronk.env
#   systemctl --user restart kronk
#
# The system service's systemd reads this file as root, so it stays 0600
# root:root even when it holds secrets. Every `kronk server start` flag has a
# KRONK_* equivalent; run `kronk server start --help` for the full list.

# Listen address. The default is local only. Configure authorization before
# binding to another interface.
# KRONK_WEB_API_HOST=127.0.0.1:11435
# KRONK_AUTHORIZATION_MODE=authenticated

# Serve the browser UI at /admin/.
# KRONK_WEB_ADMIN_ENABLED=true

# Let `kronk model pull` (without --local) and the browser UI download models
# through the service, so no `sudo -u kronk` is needed. In the default open
# authorization mode, any local process or web page open in a local browser
# can then start downloads; management mode requires an admin token instead
# (export KRONK_TOKEN for the CLI).
# KRONK_DOWNLOAD_ENABLED=true
# KRONK_AUTHORIZATION_MODE=management

# Model pool. Files under /etc/kronk are readable by the service.
# KRONK_POOL_BUDGET_PERCENT=80
# KRONK_POOL_MODEL_CONFIG_FILE=/etc/kronk/model_config.yaml

# Shutdown budget. When raised, raise TimeoutStopSec with `systemctl edit kronk`
# to at least 2 x this value + 30s.
# KRONK_WEB_SHUTDOWN_TIMEOUT=1m

# Embedded MCP web search.
# KRONK_MCP_BRAVE_API_KEY=
